        "w": 24,
        "h": 2
      },
      "datasource": null,
      "options": {
        "mode": "markdown",
        "content": "### Цифровой двойник карьера Актогай — реальная работа и эффект системы диспетчеризации\n3D-сцена ниже — реальный карьер, данные из Ditto. Показатели: «Реальная работа» против «Без системы (расчёт)» — теневого расчёта той же смены. Полный интерфейс: **[http://localhost:8095](http://localhost:8095)**. Двойники: приложение **OpenEgiz → Twins**; `org.aktogay.smart` — реальный карьер, `org.aktogay.fixed` — теневой расчёт. Модель построена по открытым данным, операционные данные смоделированы."
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Добыто за смену, т",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Реальная работа"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Без системы (расчёт)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "opentwins-influxdb"
          },
          "query": "from(bucket: \"default\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"mqtt_consumer\" and (r.thingId == \"org.aktogay.smart:mine\" or r.thingId == \"org.aktogay.fixed:mine\") and r._field == \"value_mined_total_properties_value\")\n  |> map(fn: (r) => ({r with _field: if r.thingId == \"org.aktogay.smart:mine\" then \"Реальная работа\" else \"Без системы (расчёт)\"}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "id": 2,
      "datasource": {
        "type": "influxdb",
        "uid": "opentwins-influxdb"
