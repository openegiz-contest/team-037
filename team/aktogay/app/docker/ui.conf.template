# Шаблон nginx (envsubst официального образа подставляет ${DITTO_BASIC_AUTH}).
server {
  listen 80;
  server_name localhost;

  location / {
    root /usr/share/nginx/html;
    try_files $uri /index.html;
  }

  # Ditto API платформы: интерфейс читает двойников и меняет двойник управления.
  location /ditto/ {
    proxy_pass http://ditto-nginx:80/;
    proxy_set_header Authorization "Basic ${DITTO_BASIC_AUTH}";
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 1d;
    proxy_send_timeout 1d;
  }
}
