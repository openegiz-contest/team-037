# Интерфейс рудника «Актогай» (3D, KPI, сценарии «что если»): статическая сборка + nginx.
# nginx проксирует /ditto/ к Ditto платформы и сам подставляет авторизацию — пароль в браузер не попадает.
FROM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.ts tsconfig.json ./
COPY public ./public
COPY src ./src
RUN npx vite build

FROM docker.io/library/nginx:1.25-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/ui.conf.template /etc/nginx/templates/default.conf.template
